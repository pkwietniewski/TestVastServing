<?xml version="1.0" encoding="UTF-8"?>
<VAST version="4.2">
  <!-- LAYER 2: Ad Exchange Wrapper -->
  <Ad id="exchange_wrapper" sequence="1">
    <Wrapper followAdditionalWrappers="1" allowMultipleAds="0" fallbackOnNoAd="0">
      <AdSystem version="3.1">AdExchange-Marketplace</AdSystem>
      <AdTitle><![CDATA[Layer 2 - Ad Exchange Wrapper]]></AdTitle>
      <Description><![CDATA[Second wrapper layer from programmatic ad exchange]]></Description>
      <Advertiser><![CDATA[Exchange Marketplace Inc.]]></Advertiser>

      <!-- Ad Exchange Tracking -->
      <Impression id="exchange_impression_1"><![CDATA[https://httpbin.org/status/200?layer=exchange&auction=abc123&winner=dsp456]]></Impression>
      <Impression id="exchange_impression_2"><![CDATA[https://httpbin.org/status/200?layer=exchange&billing=true&cost=15.50]]></Impression>

      <!-- Exchange Pricing -->
      <Pricing model="CPM" currency="USD">15.50</Pricing>

      <Creatives>
        <Creative id="exchange_creative" sequence="1">
          <Linear skipoffset="00:00:05">
            <Duration>00:00:30</Duration>

            <TrackingEvents>
              <Tracking event="start"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=start&auction=abc123]]></Tracking>
              <Tracking event="firstQuartile"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=q1&auction=abc123]]></Tracking>
              <Tracking event="midpoint"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=midpoint&auction=abc123]]></Tracking>
              <Tracking event="thirdQuartile"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=q3&auction=abc123]]></Tracking>
              <Tracking event="complete"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=complete&auction=abc123]]></Tracking>
              <Tracking event="skip"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=skip&auction=abc123]]></Tracking>
              <Tracking event="mute"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=mute]]></Tracking>
              <Tracking event="unmute"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=unmute]]></Tracking>
              <Tracking event="pause"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=pause]]></Tracking>
              <Tracking event="resume"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=resume]]></Tracking>
              <Tracking event="fullscreen"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=fullscreen]]></Tracking>
              <Tracking event="exitFullscreen"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=exitfullscreen]]></Tracking>
              <Tracking event="acceptInvitation"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=accept]]></Tracking>
              <Tracking event="adExpand"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=expand]]></Tracking>
              <Tracking event="adCollapse"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=collapse]]></Tracking>
              <Tracking event="minimize"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=minimize]]></Tracking>
            </TrackingEvents>

            <VideoClicks>
              <ClickTracking id="exchange_click"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=click&auction=abc123&buyer=dsp456]]></ClickTracking>
            </VideoClicks>
          </Linear>
        </Creative>
      </Creatives>

      <!-- Points to Layer 3 (DSP) -->
      <VASTAdTagURI><![CDATA[https://raw.githubusercontent.com/pkwietniewski/TestVastServing/refs/heads/main/VAST_4.2/vast_1_wrapped_dsp.xml]]></VASTAdTagURI>

      <!-- Error Tracking -->
      <Error><![CDATA[https://httpbin.org/status/200?layer=exchange&error=[ERRORCODE]&auction=abc123]]></Error>

      <!-- Exchange Extensions -->
      <Extensions>
        <Extension type="exchange_data">
          <AuctionID>abc123</AuctionID>
          <WinnerDSP>dsp456</WinnerDSP>
          <WinPrice currency="USD">15.50</WinPrice>
          <BidFloor currency="USD">10.00</BidFloor>
          <ExchangeFee currency="USD">0.75</ExchangeFee>
          <PaymentModel>CPM</PaymentModel>
        </Extension>
        <Extension type="fraud_detection">
          <Vendor name="WhiteOps">
            <Parameter name="siteID">exchange_site_001</Parameter>
            <Parameter name="partnerID">exchange_partner_123</Parameter>
          </Vendor>
        </Extension>
      </Extensions>

      <!-- Exchange Viewability -->
      <ViewableImpression id="exchange_viewable">
        <Viewable><![CDATA[https://httpbin.org/status/200?layer=exchange&viewable=true&auction=abc123]]></Viewable>
        <NotViewable><![CDATA[https://httpbin.org/status/200?layer=exchange&viewable=false&auction=abc123]]></NotViewable>
        <ViewUndetermined><![CDATA[https://httpbin.org/status/200?layer=exchange&viewable=unknown&auction=abc123]]></ViewUndetermined>
      </ViewableImpression>
    </Wrapper>
  </Ad>
</VAST>