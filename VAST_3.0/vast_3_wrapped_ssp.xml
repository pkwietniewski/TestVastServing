              <Tracking event="close"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=close&version=3.0]]></Tracking>
              <Tracking event="rewind"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=rewind&version=3.0]]></Tracking>
            </TrackingEvents>

            <VideoClicks>
              <ClickThrough><![CDATA[https://www.example.com/fallback-exchange-v3]]></ClickThrough>
              <ClickTracking><![CDATA[https://httpbin.org/status/200?layer=exchange&event=click&auction=abc123&version=3.0]]></ClickTracking>
            </VideoClicks>
          </Linear>
        </Creative>
      </Creatives>

      <!-- Exchange Extensions -->
      <Extensions>
        <Extension type="exchange_data_v3">
          <AuctionID>abc123</AuctionID>
          <WinnerDSP>dsp456</WinnerDSP>
          <WinPrice currency="USD">15.50</WinPrice>
          <BidFloor currency="USD">10.00</BidFloor>
          <ExchangeFee currency="USD">0.75</ExchangeFee>
          <PaymentModel>CPM</PaymentModel>
          <VASTVersion>3.0</VASTVersion>
        </Extension>
        <Extension type="fraud_detection_v3">
          <Vendor name="WhiteOps">
            <Parameter name="siteID">exchange_site_001</Parameter>
            <Parameter name="partnerID">exchange_partner_123</Parameter>
          </Vendor>
        </Extension>
      </Extensions>
    </Wrapper>
