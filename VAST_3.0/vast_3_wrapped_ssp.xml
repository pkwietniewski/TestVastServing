<?xml version="1.0" encoding="UTF-8"?>
<VAST version="3.0">
  <!-- LAYER 2: Ad Exchange Wrapper - VAST 3.0 -->
  <Ad id="exchange_wrapper_v3" sequence="1">
    <Wrapper>
      <AdSystem version="3.0">AdExchange-Marketplace-v3</AdSystem>
      <VASTAdTagURI><![CDATA[https://raw.githubusercontent.com/pkwietniewski/TestVastServing/refs/heads/main/VAST_3.0/vast_2_wrapped_exchange.xml]]></VASTAdTagURI>
