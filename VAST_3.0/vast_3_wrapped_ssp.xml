              <Tracking event="thirdQuartile"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=q3&auction=abc123&version=3.0]]></Tracking>
              <Tracking event="complete"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=complete&auction=abc123&version=3.0]]></Tracking>
              <Tracking event="mute"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=mute&version=3.0]]></Tracking>
              <Tracking event="unmute"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=unmute&version=3.0]]></Tracking>
              <Tracking event="pause"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=pause&version=3.0]]></Tracking>
              <Tracking event="resume"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=resume&version=3.0]]></Tracking>
              <Tracking event="fullscreen"><![CDATA[https://httpbin.org/status/200?layer=exchange&event=fullscreen&version=3.0]]></Tracking>
